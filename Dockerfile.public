FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/Ambiquality.Core/Ambiquality.Core.csproj", "src/Ambiquality.Core/"]
COPY ["src/Ambiquality.Public.Api/Ambiquality.Public.Api.csproj", "src/Ambiquality.Public.Api/"]
RUN dotnet restore "src/Ambiquality.Public.Api/Ambiquality.Public.Api.csproj"
COPY src/ src/
RUN dotnet publish "src/Ambiquality.Public.Api/Ambiquality.Public.Api.csproj" -c Release -o /app/publish

# No migrator stage: Public.Api is read-only and never runs migrations.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 6400
ENTRYPOINT ["dotnet", "Ambiquality.Public.Api.dll"]
