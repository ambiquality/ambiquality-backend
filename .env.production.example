# Production server environment for compose.ghcr.yml.
#
# Copy to `.env` ON THE VPS (never commit the filled-in file), `chmod 600`, and
# fill every value. compose.ghcr.yml reads this automatically. The `:?error`
# defaults in the compose mean a missing secret fails the deploy loudly rather
# than starting with a blank password.
#
#   cp .env.production.example .env && chmod 600 .env && $EDITOR .env

# ── Storage location (one-time Podman provisioning, NOT read by compose) ────
# The scalable Hetzner cloud volume's mount point. The Podman setup step
# (docs/deployment.md) templates the rootless graphroot from this, so all image
# layers and named volumes — including postgres-data — live on the cloud volume.
# This is the single place the data path is configured.
PODMAN_DATA_ROOT=/mnt/HC_Volume_106004051

# ── Image tags (set per deploy; deploy.sh exports these) ────────────────────
# Backend release tag (drives all ghcr.io/ambiquality/* app + migrate images).
TAG=latest
# Frontend release tag (versions independently from the backend).
FRONTEND_TAG=latest

# ── Secrets — generate fresh, do NOT reuse the dev values ───────────────────
# 32+ char random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Postgres superuser (also used by the migration containers, which need it to
# CREATE EXTENSION timescaledb / create_hypertable).
POSTGRES_PASSWORD=change-me

# Per-service DB role passwords. These are baked into the roles at FIRST init
# (init-databases.sql.tpl). Changing them later requires an ALTER ROLE, not just
# an .env edit.
AUTH_API_DB_PASSWORD=change-me
EVIDENCE_API_DB_PASSWORD=change-me
INGESTION_API_DB_PASSWORD=change-me
PUBLIC_API_DB_PASSWORD=change-me
EXPORT_WORKER_DB_PASSWORD=change-me

# ── Ingress / TLS (Caddyfile.production) ────────────────────────────────────
# API host. Frontend apex/www are hardcoded in Caddyfile.production.
DOMAIN=api.ambiquality.org
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=admin@ambiquality.org

# ── Runtime ─────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── JWT issuance ────────────────────────────────────────────────────────────
JWT_ISSUER=ambiquality-auth
JWT_AUDIENCE=ambiquality
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_CONFIRMATION_TOKEN_HOURS=24

# ── Refresh-token cookie (Auth.Api) ─────────────────────────────────────────
# The refresh token is delivered as an HttpOnly + SameSite=Strict cookie; this
# flag marks it Secure. MUST be true in production (HTTPS only). Dev (plain
# http://localhost) keeps it unset/false.
AUTH_REFRESH_COOKIE_SECURE=true

# ── SMTP (self-hosted mail server, mail.ambiquality.org) ────────────────────
# Submission on 465 + implicit TLS (the server listens on 465/smtps, not 587).
# SMTP_USE_STARTTLS=false → MailKit's Auto mode detects 465 and uses SslOnConnect.
# For a STARTTLS server instead, use SMTP_PORT=587 + SMTP_USE_STARTTLS=true.
# Ensure SPF/DKIM/DMARC are set for ambiquality.org so confirmation mail isn't
# spam-filtered; the PTR for 46.225.66.157 already resolves to the domain.
SMTP_HOST=mail.ambiquality.org
SMTP_PORT=465
SMTP_USE_STARTTLS=false
# Mailbox login. For a self-hosted server the username is usually the full email
# address. Both are required — if SMTP_USERNAME is empty the sender skips AUTH and
# the server will reject submission. FROM must be a sending identity the mailbox is
# allowed to use (the mailbox itself or an authorized alias).
SMTP_USERNAME=no-reply@ambiquality.org
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=no-reply@ambiquality.org
SMTP_FROM_NAME=Ambiquality

# ── Frontend base URL — baked into email confirmation links (F01) ───────────
APP_FRONTEND_BASE_URL=https://ambiquality.org

# ── CORS — browser origins allowed to call Auth.Api / Evidence.Api ──────────
# The SPA origin(s). Comma-separated if more than one. Public.Api is open data
# (any origin) and ignores this.
CORS_ALLOWED_ORIGINS=https://ambiquality.org

# ── Public.Api linked-data base IRI ─────────────────────────────────────────
# The canonical open-data identifier host (Caddyfile.production's data. block
# proxies it to public-api with no prefix, so /v1/… resolves one-to-one).
PUBLIC_API_BASE_IRI=https://data.ambiquality.org/v1

# ── Export.Worker archives → Hetzner S3 (F17) ───────────────────────────────
EXPORT_STORAGE_TYPE=S3
EXPORT_S3_SERVICE_URL=https://<region>.your-objectstorage.com
EXPORT_S3_BUCKET_NAME=ambiquality-exports
EXPORT_S3_ACCESS_KEY=change-me
EXPORT_S3_SECRET_KEY=change-me
EXPORT_S3_PUBLIC_BASE_URL=https://ambiquality-exports.<region>.your-objectstorage.com

# ── Postgres off-site backups (SPO-04, RPO ≤ 24 h) ──────────────────────────
# Point at a bucket on storage INDEPENDENT from the postgres-data volume.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=ambiquality-pg-backups
BACKUP_S3_ENDPOINT=https://<region>.your-objectstorage.com
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
BACKUP_S3_REGION=us-east-1

# ── Observability (compose.monitoring.yml) ───────────────────────────────────
# Grafana is bound to 127.0.0.1 ONLY — reachable exclusively via SSH port
# forwarding (`ssh -L 3000:127.0.0.1:3000 -L 9090:127.0.0.1:9090 …`), never through
# the public ingress. A real admin password is REQUIRED (GF_ADMIN_PASSWORD is
# mandatory in compose.monitoring.yml).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
# Prometheus metric retention (e.g. 30d).
PROMETHEUS_RETENTION=30d
