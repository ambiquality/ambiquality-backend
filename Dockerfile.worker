FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/Ambiquality.Core/Ambiquality.Core.csproj", "src/Ambiquality.Core/"]
COPY ["src/Ambiquality.Observability/Ambiquality.Observability.csproj", "src/Ambiquality.Observability/"]
COPY ["src/Ambiquality.Ingestion.Worker/Ambiquality.Ingestion.Worker.csproj", "src/Ambiquality.Ingestion.Worker/"]
RUN dotnet restore "src/Ambiquality.Ingestion.Worker/Ambiquality.Ingestion.Worker.csproj"
COPY src/ src/
RUN dotnet publish "src/Ambiquality.Ingestion.Worker/Ambiquality.Ingestion.Worker.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
# Npgsql probes the Kerberos/GSSAPI library on first connect; without it the
# runtime image logs a benign "Cannot load library libgssapi_krb5.so.2" before
# falling back to password/SCRAM auth. Install it to keep the logs clean (the
# ingestion migrator image installs the same package).
RUN apt-get update && apt-get install -y --no-install-recommends libgssapi-krb5-2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Ambiquality.Ingestion.Worker.dll"]
