{
  "uid": "ambiquality-infra-use",
  "title": "Ambiquality — Infrastructure USE",
  "tags": ["ambiquality", "monitoring"],
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=\"ambiquality\"}, service)" },
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Utilization (per service process, USE - U)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU cores used per service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "core", "decimals": 2, "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (service)(rate({__name__=\"dotnet.process.cpu.time_seconds_total\",service=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory working set (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (service)({__name__=\"dotnet.process.memory.working_set_bytes\",service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GC heap size (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (service)({__name__=\"dotnet.gc.last_collection.heap.size_bytes\",service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Thread pool queue (saturation)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "count", "custom": { "drawStyle": "bars", "fillOpacity": 30 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (service)({__name__=\"dotnet.thread_pool.queue.length_total\",service=~\"$service\"})", "legendFormat": "{{service}}" } ]
    },
    { "id": 6, "type": "row", "title": "Host (the VPS)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 } },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host CPU %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 - avg by (instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100", "legendFormat": "{{instance}}" } ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host memory %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "memory" } ]
    },
    { "id": 9, "type": "row", "title": "Data stores (Postgres, Redis) — saturation", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Postgres connections (active vs max)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (datname)({__name__=\"pg_stat_activity_count\"})", "legendFormat": "{{datname}} connections" },
        { "refId": "B", "expr": "{__name__=\"pg_settings_max_connections\"}", "legendFormat": "max connections" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Redis clients / memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "{__name__=\"redis_memory_used_bytes\"}", "legendFormat": "used bytes" },
        { "refId": "B", "expr": "{__name__=\"redis_connected_clients\"}", "legendFormat": "clients" }
      ]
    },
    { "id": 12, "type": "row", "title": "Ingestion queue (write-path saturation)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 } },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Queue depth (enqueued not yet drained)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "{__name__=\"ambiquality.queue.measurements_pending\"}", "legendFormat": "pending {{stream}}" } ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Unacked backlog / drain gap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "{__name__=\"ambiquality.queue.last_drain_gap_seconds\"}", "legendFormat": "seconds since last drain" }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Unacked stream entries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 38 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "max({__name__=\"ambiquality.queue.measurements_unacked\"})", "legendFormat": "unacked" } ]
    }
  ]
}
