{
  "uid": "ambiquality-service-red",
  "title": "Ambiquality — Service RED",
  "tags": ["ambiquality", "monitoring"],
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=\"ambiquality\"}, service)" },
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Services", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rate (requests per second)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (service)(rate({__name__=\"http.server.request.duration_seconds_count\",service=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors (5xx per second)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "count", "custom": { "drawStyle": "bars", "fillOpacity": 40 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (service)(rate({__name__=\"http.server.request.duration_seconds_count\",service=~\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{service}}" } ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate %",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (service)(rate({__name__=\"http.server.request.duration_seconds_count\",service=~\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum by (service)(rate({__name__=\"http.server.request.duration_seconds_count\",service=~\"$service\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Responses by status code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "count", "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (http_response_status_code)(rate({__name__=\"http.server.request.duration_seconds_count\",service=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{http_response_status_code}}" } ]
    },
    { "id": 6, "type": "row", "title": "Duration (the 'D' of RED)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 } },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p99 latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le,service)(rate({__name__=\"http.server.request.duration_seconds_bucket\",service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 / p50 latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "showPoints": "never", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le)(rate({__name__=\"http.server.request.duration_seconds_bucket\",service=~\"$service\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le)(rate({__name__=\"http.server.request.duration_seconds_bucket\",service=~\"$service\"}[$__rate_interval])))", "legendFormat": "p50" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Average latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=\"http.server.request.duration_seconds_sum\",service=~\"$service\"}[$__rate_interval])) / sum(rate({__name__=\"http.server.request.duration_seconds_count\",service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "avg"
        }
      ]
    }
  ]
}
