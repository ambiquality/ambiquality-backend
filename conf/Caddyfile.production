# Production ingress (SYS-01: HTTPS-only with HTTP→HTTPS redirect).
#
# The committed `Caddyfile` binds plain :80 for local development. In production,
# use THIS file as /etc/caddy/Caddyfile instead (deploy.sh copies it over
# conf/Caddyfile on the host) and:
#
#   1. set DOMAIN (the API host, e.g. api.ambiquality.org) and ACME_EMAIL in the
#      environment (the server .env),
#   2. publish ports 80 and 443 on the caddy service — already done in
#      compose.ghcr.yml,
#   3. point DNS for the open-data host (data.ambiquality.org) at this ingress and
#      set PUBLIC_API_BASE_IRI=https://data.ambiquality.org/v1 in the server .env so
#      the public-api mints IRIs under the canonical data host (see the data. block
#      below and Ambiquality.Public.Api/README.md → Deployment note).
#
# Each domain-addressed site block makes Caddy provision and renew certificates
# automatically (Let's Encrypt) and answer plain HTTP on :80 only with a 308
# redirect to HTTPS — no cleartext traffic is served. The Cloudflare records for
# these names are DNS-only (grey cloud), so the ACME challenge reaches Caddy.
{
	email {$ACME_EMAIL}
}

# ── Shared security headers (WSTG-CONF-07/12/14) ────────────────────────────
# Defense-in-depth at the single ingress choke-point: HSTS, MIME-sniffing
# protection, frame protection, referrer trimming and permissions disabling.
# The SPA block additionally gets a Content-Security-Policy tuned to the built
# app's real origins (self bundle, MapLibre workers, OpenFreeMap style/tiles,
# the API host for XHR + RUM beacons). -Server hides the Caddy/Kestrel banner.
(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(spa_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://api.ambiquality.org https://tiles.openfreemap.org; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

# ── Backend API (path-routed to each service) ──────────────────────────────
{$DOMAIN} {
	import site_headers

	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type application/ld+json*
			header Content-Type text/*
			header Content-Type application/problem+json*
		}
	}

	handle_path /evidence/* {
		reverse_proxy evidence-api:6200
	}

	handle_path /ingestion/* {
		reverse_proxy ingestion-api:6300
	}

	handle_path /public/* {
		reverse_proxy public-api:6400
	}

	handle_path /auth/* {
		reverse_proxy auth-api:6100
	}
}

# ── Open-data identifier host (canonical public IRIs) ───────────────────────
# data.ambiquality.org is the permanent namespace/identifier host for the open
# data (the ambiq: namespace, observation/property/codelist IRIs, JSON-Schema
# $ids, CSVW propertyUrls). It reverse-proxies straight to public-api with NO
# /public prefix, so https://data.ambiquality.org/v1/… maps one-to-one to the
# service's /v1/… — the published IRIs therefore resolve. Keep this in lockstep
# with PUBLIC_API_BASE_IRI=https://data.ambiquality.org/v1 in the server .env.
data.ambiquality.org {
	import site_headers

	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type application/ld+json*
			header Content-Type text/*
			header Content-Type application/problem+json*
		}
	}

	reverse_proxy public-api:6400
}

# ── Frontend SPA (apex + www) ───────────────────────────────────────────────
# Canonicalize www → apex, then reverse-proxy to the frontend container, which
# serves the static bundle with its own SPA history fallback.
www.ambiquality.org {
	import site_headers
	redir https://ambiquality.org{uri} permanent
}

ambiquality.org {
	import spa_headers

	encode {
		zstd
		gzip
	}

	reverse_proxy frontend:80
}
