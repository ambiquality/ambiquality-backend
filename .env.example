# ── Secrets (override locally; never commit real values) ────────────────────
JWT_SECRET=change-me-to-a-32+char-random-string

# Postgres superuser (also used by migration containers)
POSTGRES_PASSWORD=postgres

# Per-service DB role passwords (MUST match init-databases.sql at first init)
AUTH_API_DB_PASSWORD=auth_api_dev_password
EVIDENCE_API_DB_PASSWORD=evidence_api_dev_password
INGESTION_API_DB_PASSWORD=ingestion_api_dev_password
PUBLIC_API_DB_PASSWORD=public_api_dev_password
EXPORT_WORKER_DB_PASSWORD=export_worker_dev_password

# Export.Worker object storage (development uses FileSystem; switch to S3 in prod)
EXPORT_STORAGE_TYPE=FileSystem
EXPORT_S3_SERVICE_URL=
EXPORT_S3_BUCKET_NAME=
EXPORT_S3_ACCESS_KEY=
EXPORT_S3_SECRET_KEY=
EXPORT_S3_PUBLIC_BASE_URL=

# Postgres backups (SPO-04). Leave the S3 vars empty in dev — runs then stay on the
# local backup-data volume only. Production MUST point them at an S3-compatible
# bucket on storage independent from the database volume (off-site copy, RPO ≤ 24 h).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1

# pgAdmin (development profile only)
PGADMIN_DEFAULT_EMAIL=admin@ambiquality.dev
PGADMIN_DEFAULT_PASSWORD=admin

# ── Environment / config (non-secret but environment-specific) ──────────────
ASPNETCORE_ENVIRONMENT=Development

# JWT issuance
JWT_ISSUER=ambiquality-auth
JWT_AUDIENCE=ambiquality
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_CONFIRMATION_TOKEN_HOURS=24

# SMTP (dev uses Mailpit; replace with real relay in production)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=no-reply@ambiquality.cz
SMTP_FROM_NAME=Ambiquality

# Frontend
APP_FRONTEND_BASE_URL=https://app.ambiquality.cz
