{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "Export": {
    "StorageType": "FileSystem",
    "BaseIri": "https://data.ambiquality.org",
    "FileSystem": {
      "BasePath": "/exports",
      "PublicBaseUrl": ""
    },
    "S3": {
      "ServiceUrl": "",
      "BucketName": "",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": ""
    }
  }
}
