{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "AllowedHosts": "*",
  "IngestionApi": {
    "//BaseIri": "Externally-reachable versioned root (e.g. https://data.ambiquality.org/ingestion/v1). Sets the OpenAPI server URL shown in the Scalar reference; empty in dev.",
    "BaseIri": ""
  },
  "ConnectionStrings": {
    "IeqDb": "Host=localhost;Port=6432;Database=ieq;Username=ingestion_api;Password=ingestion_api_dev_password",
    "EvidenceDb": "Host=localhost;Port=6432;Database=evidence;Username=ingestion_api;Password=ingestion_api_dev_password",
    "Redis": "localhost:6379"
  },
  "MeasurementQueue": {
    "StreamKey": "ieq:measurements",
    "PayloadField": "payload",
    "ConsumerGroup": "writers"
  },
  "IngestionRateLimit": {
    "Enabled": true,
    "DefaultIntervalSeconds": 300,
    "MinIntervalSeconds": 300,
    "PermitsPerWindow": 1
  }
}
