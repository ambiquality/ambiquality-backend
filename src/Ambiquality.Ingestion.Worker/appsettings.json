{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "ConnectionStrings": {
    "IeqDb": "Host=localhost;Port=6432;Database=ieq;Username=ingestion_api;Password=ingestion_api_dev_password",
    "Redis": "localhost:6379"
  },
  "MeasurementQueue": {
    "StreamKey": "ieq:measurements",
    "PayloadField": "payload",
    "ConsumerGroup": "writers",
    "BatchSize": 200,
    "BlockMilliseconds": 2000
  }
}
