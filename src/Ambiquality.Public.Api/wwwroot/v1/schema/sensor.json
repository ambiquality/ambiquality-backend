{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.ambiquality.org/v1/schema/sensor.json",
  "title": "Sensor",
  "description": "Public projection of a sensor (current temporal state).",
  "type": "object",
  "required": ["id", "iri", "buildingId", "roomId", "measuredParameters", "license"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "iri": { "type": "string", "format": "uri" },
    "buildingId": { "type": "string", "format": "uuid" },
    "roomId": { "type": "string", "format": "uuid" },
    "manufacturer": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "serialNumber": { "type": ["string", "null"] },
    "statusCode": { "type": ["string", "null"] },
    "measuredParameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "quantityKindUri": { "type": ["string", "null"], "format": "uri" },
          "unitUri": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },
    "license": { "type": "string", "format": "uri" }
  }
}
